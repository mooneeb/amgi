        },
        "assignees": {
          "$ref": "#/$defs/FieldOperators"
        },
        "author": {
          "$ref": "#/$defs/FieldOperators"
        },
        "title": {
          "$ref": "#/$defs/FieldOperators"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Repository": {
      "properties": {
