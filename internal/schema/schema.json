      "properties": {
        "port": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 1,
          "default": 8080
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "default": "/webhooks/github"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "$comment": "DO NOT MODIFY THIS FILE DIRECTLY. IT IS AUTO-GENERATED BY THE amgi/internal/schema/generate_schema.go."
